# Copy this file to `.env` (never committed) and adjust the values.
# The server refuses to start when a required variable is missing or invalid.

# --- Server ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Exact origin of the web app (scheme + host + port). Used for CORS.
# Production example: https://ressa.games
WEB_ORIGIN=http://localhost:5173
# Set to true only when running behind a reverse proxy that terminates HTTPS/WSS.
TRUST_PROXY=false

# --- Database (local Docker Compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=app_dev
DATABASE_URL=postgresql://app:change-me-local-only@127.0.0.1:5432/app_dev

# --- Images (lot 1C) ---
# Private directory for the image files, relative to apps/server or absolute.
# It is never served as static files: images leave only through protected routes.
STORAGE_DIR=./storage
# Limits (defaults shown). Uploads above these are refused.
UPLOAD_MAX_BYTES=15000000
IMAGE_MAX_PIXELS=40000000
IMAGE_MIN_SIDE=256
# Images processed at the same time.
IMAGE_CONCURRENCY=2
