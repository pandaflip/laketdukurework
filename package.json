{
  "name": "laketdukurework",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @app/e2e e2e",
    "db:up": "docker compose --env-file .env up -d",
    "db:down": "docker compose --env-file .env down",
    "db:migrate": "pnpm --filter @app/server db:migrate",
    "db:migrate:dev": "pnpm --filter @app/server db:migrate:dev",
    "db:seed": "pnpm --filter @app/server db:seed",
    "admin:create": "pnpm --filter @app/server admin:create"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
